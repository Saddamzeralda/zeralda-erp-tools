# Zeralda ERP — قالب إعدادات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم
# cp .env.example .env

PORT=8080
DEBUG=False
ENVIRONMENT=development

# ═══ المصادقة (FIX #1: مطلوبة افتراضياً) ═══
# في الإنتاج: REQUIRE_AUTH=True دائماً (لا يمكن تعطيله)
# في التطوير: اضبط AUTH_DISABLED_IN_DEV=true لتجاوز المصادقة (للتجارب فقط)
AUTH_DISABLED_IN_DEV=false

# ═══ CORS — قائمة بيضاء صريحة (FIX #11) ═══
# قائمة الأصول المسموح بها مفصولة بفواصل. لا "أي IP خاص" بعد الآن.
# localhost/127.0.0.1 على PORT مُضافة ضمنياً تلقائياً.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ═══ Proxy موثوق (FIX #13) ═══
# عدد الـ hops الخلفية الموثوقة في X-Forwarded-For.
# 0 = تجاهل XFF تماماً (العميل مباشر). 1 = خلف proxy واحد.
TRUSTED_PROXY_COUNT=0

# ═══ Rate limiting (FIX #14) ═══
AUTH_RATE_WINDOW_SECONDS=60
AUTH_RATE_MAX_ATTEMPTS=8

# ═══ حدود الـ body (FIX #16) ═══
MAX_BODY_BYTES=20971520
MAX_AUTH_BODY_BYTES=8192

# ═══ Google OAuth (FIX #18) ═══
# افتراضياً: لا إنشاء مستخدمين تلقائياً. يجب أن يوافق الأدمن.
GOOGLE_AUTO_CREATE_USERS=false
GOOGLE_CLIENT_ID=

# حساب المشرف الافتراضي (عند أول تثبيت فقط)
DEFAULT_ADMIN_EMAIL=admin@yourcompany.dz
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY
DEFAULT_ADMIN_USERNAME=Admin

# مفتاح الجلسة — يجب تعيينه لضمان استمرار الجلسات بعد إعادة التشغيل
# أنشئ مفتاحاً عشوائياً:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_RANDOM_64_HEX_CHARS

# مفتاح JWT (مستخدم للتوافق)
JWT_SECRET=CHANGE_ME_USE_RANDOM_64_CHARS

# قاعدة بيانات PostgreSQL (اختياري)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zeralda_erp
DB_USER=zeralda_user
DB_PASSWORD=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_USE_RANDOM_64_HEX

BACKUP_INTERVAL=3600
AUTO_SHUTDOWN_ON_CLIENT_CLOSE=false
AUTO_SHUTDOWN_GRACE_SECONDS=300

# AI (Hugging Face)
# ضع مفتاحك هنا أو من إعدادات AI داخل التطبيق
HUGGINGFACE_API_KEY=CHANGE_ME_HUGGINGFACE_API_KEY
# النماذج المقترحة: mistralai/Mistral-7B-Instruct-v0.2 | meta-llama/Llama-3-8b-chat-hf
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# اختياري: غيّرها فقط إذا كنت تستخدم بوابة API مختلفة
HUGGINGFACE_API_BASE=https://api-inference.huggingface.co

# هل يُدرج AI بيانات الشركة في سياق المحادثة؟
# true = AI يقرأ بيانات ERP ويجيب بدقة أعلى (افتراضي)
# AI_INJECT_STORE_DATA=true

# ═══ نظام الترخيص (License System) ═══
# مسار حفظ مفاتيح RSA (تُولّد تلقائياً عند أول تشغيل إذا لم تكن موجودة)
LICENSE_KEY_DIR=data
# عدد أيام التجربة المجانية (افتراضي: 14)
LICENSE_TRIAL_DAYS=14
# فترة السماح بالساعات بعد انتهاء الترخيص (افتراضي: 72)
LICENSE_GRACE_HOURS=72
# فترة إعادة التحقق بالساعات (افتراضي: 1)
LICENSE_REVALIDATE_HOURS=1

# ═══ بدء التشغيل والرابط المباشر (Startup URL) ═══
STARTUP_URL=https://zeralda-erp-employees-main-production.up.railway.app/zeralda_erp_dashboard.html
AUTO_OPEN_BROWSER=true
ENABLE_REMOTE_TUNNEL=true
